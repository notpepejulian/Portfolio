---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from "../../utils/i18n";
import Layout from "../../layouts/Layout.astro";

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const backUrl = lang === 'es' ? getRelativeLocaleUrl(lang, 'proyectos/') : getRelativeLocaleUrl(lang, 'projects/');
---

<style>
	html {
		scroll-behavior: smooth;
	}

	/* Animación de tecnologías desplazándose */
	@keyframes scroll {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	.tech-scroll {
		animation: scroll 30s linear infinite;
	}

	.tech-scroll:hover {
		animation-play-state: paused;
	}

	.tech-container {
		overflow: hidden;
		mask-image: linear-gradient(
			to right,
			transparent,
			black 10%,
			black 90%,
			transparent
		);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent,
			black 10%,
			black 90%,
			transparent
		);
	}
</style>

<Layout title={lang === 'es' ? "Nacho Sánchez | AutoTest" : "Nacho Sánchez | AutoTest"}>
	<main
		class="flex flex-col min-h-screen items-center justify-center px-6 py-20 bg-transparent relative"
	>
		<div class="max-w-4xl w-full text-center z-10">
			<div
				class="inline-flex items-center gap-4 px-4 py-1.5 border border-red-400/20 rounded bg-red-500/10 mb-6"
			>
				<span class="h-2 w-2 rounded-full bg-red-400 animate-pulse"
				></span>
				<span class="text-red-300 font-mono text-[10px] tracking-widest uppercase font-bold"
					>{t('project_data.AutoTest.status')}</span
