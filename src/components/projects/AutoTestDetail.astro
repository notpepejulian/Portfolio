			</div>
			<h1
				class="font-headline text-5xl md:text-7xl font-bold tracking-tighter bg-gradient-to-r from-red-400 via-orange-400 to-amber-400 bg-clip-text text-transparent mb-6"
			>
				AutoTest
			</h1>
			<p class="text-xl sm:text-2xl font-light text-on-surface-variant mb-6">
				{t('project_pages.AutoTest.subtitle')}
			</p>
			<p
				class="text-lg text-on-surface-variant font-light mb-10 max-w-2xl mx-auto leading-relaxed"
			>
				{t('project_pages.AutoTest.description')}
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
				<a
					href="https://github.com/notpepejulian/AutoTest"
					target="_blank"
					class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-red-600 hover:bg-red-500 text-white font-headline tracking-wider uppercase text-xs shadow-lg transition-all duration-200 group"
				>
					<span>{t('project_pages.AutoTest.github_cta')}</span>
				</a>
				<a
					href={backUrl}
					class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-red-300 font-headline tracking-wider uppercase text-xs shadow-lg transition-all duration-200 border border-red-400/30"
				>
					{t('projects.back')}
				</a>
			</div>
		</div>
