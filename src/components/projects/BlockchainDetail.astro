		class="flex flex-col min-h-screen items-center justify-center px-6 py-20 bg-transparent relative"
	>
		<div class="max-w-4xl w-full text-center z-10">
			<div
				class="inline-flex items-center gap-4 px-4 py-1.5 border border-fuchsia-400/20 rounded bg-fuchsia-500/10 mb-6"
			>
				<span class="h-2 w-2 rounded-full bg-fuchsia-400 animate-pulse"
				></span>
				<span class="text-fuchsia-300 font-mono text-[10px] tracking-widest uppercase font-bold"
					>{t('project_data.blockchain-integracion-bd.status')}</span
				>
			</div>
			<h1
				class="font-headline text-5xl md:text-7xl font-bold tracking-tighter bg-gradient-to-r from-fuchsia-400 via-pink-400 to-purple-400 bg-clip-text text-transparent mb-6"
			>
				{t('project_data.blockchain-integracion-bd.title')}
			</h1>
			<p class="text-xl sm:text-2xl font-light text-on-surface-variant mb-6">
				{t('project_pages.blockchain-integracion-bd.subtitle')}
			</p>
			<p
				class="text-lg text-on-surface-variant font-light mb-10 max-w-2xl mx-auto leading-relaxed"
			>
				{t('project_pages.blockchain-integracion-bd.description')}
