---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from "../../utils/i18n";
import Layout from "../../layouts/Layout.astro";

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const backUrl = lang === 'es' ? getRelativeLocaleUrl(lang, 'proyectos/') : getRelativeLocaleUrl(lang, 'projects/');
---

<style>
	html {
		scroll-behavior: smooth;
	}

	/* Animación de tecnologías desplazándose */
	@keyframes scroll {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	.tech-scroll {
		animation: scroll 30s linear infinite;
	}

	.tech-scroll:hover {
		animation-play-state: paused;
	}

	.tech-container {
		overflow: hidden;
		mask-image: linear-gradient(
			to right,
			transparent,
			black 10%,
			black 90%,
			transparent
		);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent,
			black 10%,
			black 90%,
			transparent
		);
	}
</style>

<Layout title={lang === 'es' ? "Nacho Sánchez | Integración Blockchain" : "Nacho Sánchez | Blockchain Integration"}>
