        class="flex flex-col min-h-screen items-center justify-center px-6 py-20 bg-transparent relative"
    >
        <div class="max-w-4xl w-full text-center z-10">
            <div
                class="inline-flex items-center gap-4 px-4 py-1.5 border border-yellow-400/20 rounded bg-yellow-500/10 mb-6"
            >
                <span class="h-2 w-2 rounded-full bg-yellow-400 animate-pulse"
                ></span>
                <span class="text-yellow-300 font-mono text-[10px] tracking-widest uppercase font-bold"
                    >{t('projects.in_progress')}</span
                >
            </div>
            <h1
                class="font-headline text-5xl md:text-7xl font-bold tracking-tighter bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent mb-6"
            >
                ChatSender
            </h1>
            <p class="text-xl sm:text-2xl font-light text-on-surface-variant mb-6">
                {t('project_pages.ChatSender.subtitle')}
            </p>
            <p
                class="text-lg text-on-surface-variant font-light mb-10 max-w-2xl mx-auto leading-relaxed"
            >
                {t('project_pages.ChatSender.description')}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
                <a
                    href="https://github.com/notpepejulian/SecChat"
                    target="_blank"
                    class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-blue-600 hover:bg-blue-500 text-white font-headline tracking-wider uppercase text-xs shadow-lg transition-all duration-200 group"
                >
                    <span>{t('project_pages.ChatSender.github_cta')}</span>
                </a>
                <a
                    href={backUrl}
                    class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-blue-300 font-headline tracking-wider uppercase text-xs shadow-lg transition-all duration-200 border border-blue-400/30"
                >
                    {t('projects.back')}
                </a>
            </div>
        </div>
