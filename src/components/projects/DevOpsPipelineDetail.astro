            </div>
            <h1
                class="font-headline text-5xl md:text-7xl font-bold tracking-tighter bg-gradient-to-r from-emerald-400 via-green-400 to-teal-400 bg-clip-text text-transparent mb-6"
            >
                {t('project_data.devops-pipeline.title')}
            </h1>
            <p class="text-xl sm:text-2xl font-light text-on-surface-variant mb-6">
                {t('project_pages.devops-pipeline.subtitle')}
            </p>
            <p
                class="text-lg text-on-surface-variant font-light mb-10 max-w-2xl mx-auto leading-relaxed"
            >
                {t('project_pages.devops-pipeline.description')}
            </p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
				<a
					href="https://github.com/notpepejulian/devops-pipeline"
					target="_blank"
					class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-headline tracking-wider uppercase text-xs shadow-lg transition-all duration-200 group"
				>
					<span>{t('project_pages.devops-pipeline.github_cta')}</span>
				</a>
				<a
					href={backUrl}
