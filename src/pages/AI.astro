---
import Layout from "../layouts/Layout.astro";
import { useTranslations, defaultLang } from "../utils/i18n";

const url = new URL(Astro.request.url);
const lang = url.searchParams.get('lang') || defaultLang;
const t = useTranslations(lang);
---

<Layout title="Nacho Sánchez | AI Terminal" lang={lang}>
  <main class="pt-24 min-h-screen">
    <!-- Hero section for AI -->
    <section class="max-w-screen-2xl mx-auto px-6 py-20 text-center relative overflow-hidden">
        <div class="absolute inset-0 flex items-center justify-center -z-10">
            <div class="w-[800px] h-[300px] bg-primary/20 rounded-full blur-[140px] animate-pulse"></div>
        </div>
        <p class="font-label text-xs tracking-[0.4em] text-primary uppercase mb-4 opacity-70">{t('ai.label')}</p>
        <h1 class="font-headline text-5xl md:text-7xl font-bold tracking-tighter mb-8 max-w-4xl mx-auto leading-none">
            {t('ai.title')} <span class="gradient-text drop-shadow-[0_0_30px_rgba(0,242,255,0.3)]">{t('ai.title_span')}</span>
        </h1>
        <p class="text-on-surface-variant text-lg max-w-2xl mx-auto leading-relaxed font-light">
            {t('ai.description')}
        </p>
    </section>

    <!-- Chat Interface -->
    <section class="max-w-4xl mx-auto px-6 pb-32">
        <div class="bg-surface-container rounded-3xl border border-outline-variant/15 shadow-2xl overflow-hidden flex flex-col min-h-[650px] relative">
            <!-- Decorative border glow -->
            <div class="absolute inset-0 border border-primary/10 rounded-3xl pointer-events-none"></div>

            <!-- Terminal Title Bar -->
            <div class="px-8 py-5 bg-surface-container-high border-b border-outline-variant/10 flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="flex gap-2">
                        <div class="w-3 h-3 rounded-full bg-red-500/40"></div>
                        <div class="w-3 h-3 rounded-full bg-yellow-500/40"></div>
                        <div class="w-3 h-3 rounded-full bg-green-500/40"></div>
                    </div>
                    <span class="text-[10px] font-mono text-outline opacity-60 tracking-[0.2em] uppercase">nacho@ai-core: ~/sesiones/activa</span>
                </div>
                <div class="flex items-center gap-3 px-3 py-1.5 bg-primary/10 rounded-full border border-primary/20 shadow-glow-sm" style="--glow-color: rgba(0, 242, 255, 0.3)">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                    <span class="text-[9px] font-mono text-primary font-bold tracking-widest uppercase">{t('ai.terminal_status')}</span>
                </div>
            </div>

            <!-- Messages Window -->
            <div id="chat-window" class="flex-1 p-10 overflow-y-auto font-mono text-sm space-y-10 scroll-smooth">
                <!-- Initial Bot Message -->
                <div class="flex gap-8">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0 border border-primary/20 shadow-glow-sm" style="--glow-color: rgba(0, 242, 255, 0.2)">
                        <span class="material-symbols-outlined text-primary text-xl">robot_2</span>
                    </div>
                    <div>
                        <div class="text-[10px] font-bold text-primary mb-3 uppercase tracking-[0.3em] font-headline">[{t('ai.terminal_node')}]</div>
                        <div class="text-on-surface-variant leading-relaxed max-w-2xl bg-surface-container-high/40 p-6 rounded-2xl border border-outline-variant/5">
                            {t('ai.handshake')}
                        </div>
                    </div>
                </div>
                <div id="chat-messages" class="space-y-10"></div>
            </div>

            <!-- Input Area -->
            <div class="p-8 bg-surface-container-lowest border-t border-outline-variant/10">
                <form id="chat-form" class="relative group">
                    <div class="absolute inset-y-0 left-6 flex items-center pointer-events-none">
                        <span class="text-primary font-bold mr-3 text-sm">$</span>
                    </div>
                    <input 
                        id="chat-input"
                        type="text" 
                        placeholder={lang === 'es' ? "Escribe una instrucción o consulta..." : "Type instruction or query..."} 
                        class="w-full bg-surface-container p-5 pl-12 rounded-xl border border-outline-variant/10 focus:border-primary/40 focus:ring-0 text-sm font-mono text-on-surface outline-none transition-all focus:shadow-glow-sm"
                        autocomplete="off"
                        required
                    />
                    <button type="submit" class="absolute inset-y-3 right-3 px-8 bg-primary text-on-primary rounded-lg font-headline font-black text-[10px] uppercase tracking-[0.2em] hover:scale-105 hover:shadow-glow-md duration-300 transition-all">
                        {t('ai.cta_execute')}
                    </button>
                </form>
            </div>
        </div>
    </section>

    <script is:inline>
        const chatForm = document.getElementById("chat-form");
        const chatInput = document.getElementById("chat-input");
        const chatMessages = document.getElementById("chat-messages");
        const chatWindow = document.getElementById("chat-window");

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function appendMessage(content, from = "user") {
            const msg = document.createElement("div");
            msg.className = "flex gap-8 animate-fade-in";
            
            if (from === "user") {
                msg.innerHTML = `
                    <div class="w-10 h-10 rounded-xl bg-secondary/10 flex items-center justify-center flex-shrink-0 border border-secondary/20 shadow-glow-sm" style="--glow-color: rgba(112, 0, 255, 0.2)">
                        <span class="material-symbols-outlined text-secondary text-xl">person</span>
                    </div>
                    <div class="flex-1">
                        <div class="text-[10px] font-bold text-secondary mb-3 uppercase tracking-[0.3em] font-headline">[Terminal_User]</div>
                        <div class="text-on-surface shadow-sm border border-outline-variant/5 bg-surface-container-high/60 p-6 rounded-2xl inline-block leading-relaxed">
                            ${escapeHtml(content)}
                        </div>
                    </div>
                `;
            } else if (from === "bot") {
                msg.innerHTML = `
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0 border border-primary/20 shadow-glow-sm" style="--glow-color: rgba(0, 242, 255, 0.2)">
                        <span class="material-symbols-outlined text-primary text-xl">robot_2</span>
                    </div>
                    <div class="flex-1">
                        <div class="text-[10px] font-bold text-primary mb-3 uppercase tracking-[0.3em] font-headline">[Node_Synthetix_v2]</div>
                        <div class="text-on-surface-variant leading-relaxed max-w-2xl bg-surface-container-high/40 p-6 rounded-2xl border border-outline-variant/5">
                            ${content}
                        </div>
                    </div>
                `;
            } else if (from === "thinking") {
              msg.id = "thinking-indicator";
              msg.innerHTML = `
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0 border border-primary/20">
                        <span class="material-symbols-outlined text-primary text-xl animate-spin">sync</span>
                    </div>
                    <div class="flex-1 py-2">
                        <span class="text-[10px] font-label text-primary animate-pulse uppercase tracking-[0.3em] font-black">Sincronizando_Núcleos_Neurales...</span>
                    </div>
                `;
            }
            
            chatMessages.appendChild(msg);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        chatForm?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const pregunta = chatInput.value.trim();
            if (!pregunta) return;

            appendMessage(pregunta, "user");
            chatInput.value = "";
            appendMessage("", "thinking");

            try {
                const res = await fetch("/api/ia", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ mensaje: pregunta }),
                });
                const data = await res.json();
                
                document.getElementById("thinking-indicator")?.remove();

                if (data.respuesta) {
                    appendMessage(data.respuesta, "bot");
                } else {
                    appendMessage("ERROR_CODE_404: Base de conocimientos inalcanzable. Verifique el estado del enlace.", "bot");
                }
            } catch (err) {
                document.getElementById("thinking-indicator")?.remove();
                appendMessage("FALLO_DETECTADO: Conexión rechazada por el host remoto.", "bot");
            }
        });
    </script>
  </main>
</Layout>
