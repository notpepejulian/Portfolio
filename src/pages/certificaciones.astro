---
import Layout from "../layouts/Layout.astro";
import { useTranslations, defaultLang } from "../utils/i18n";

const url = new URL(Astro.request.url);
const lang = url.searchParams.get('lang') || defaultLang;
const t = useTranslations(lang);

const certifications = [
  {
    title: "AWS Solutions Architect Associate",
    issuer: "Amazon Web Services",
    status: "EN_PROGRESO",
    description: "Diseño y despliegue de sistemas escalables, altamente disponibles y tolerantes a fallos en AWS.",
    badge: "aws_saa.png",
    link: "https://aws.amazon.com/es/certification/certified-solutions-architect-associate/",
    color: "primary"
  },
  {
    title: "GitHub Actions Automation",
    issuer: "GitHub",
    status: "COMPLETADO",
    description: "Orquestación avanzada de CI/CD utilizando GitHub Actions para desarrollo de software y pipelines de infraestructura.",
    badge: "github_actions.png",
    link: "https://docs.github.com/es/actions",
    color: "secondary"
  },
  {
    title: "AWS Cloud Practitioner",
    issuer: "Amazon Web Services",
    status: "COMPLETADO",
    description: "Comprensión fundamental de la plataforma AWS Cloud, incluyendo infraestructura básica y seguridad.",
    link: "https://aws.amazon.com/es/certification/certified-cloud-practitioner/",
    color: "tertiary"
  }
];
---

<Layout title="Nacho Sánchez | Hitos Profesionales" lang={lang}>
  <main class="pt-24 min-h-screen">
    <!-- Header -->
    <section class="max-w-screen-2xl mx-auto px-6 py-20 relative overflow-hidden text-center md:text-left">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-secondary/5 blur-[120px] -z-10 animate-pulse"></div>
      <div class="max-w-3xl">
        <p class="font-label text-xs tracking-[0.4em] text-primary uppercase mb-6 opacity-70">{t('certifications.label')}</p>
        <h1 class="font-headline text-5xl md:text-7xl font-bold tracking-tighter leading-none mb-8">
            {t('certifications.title')} <span class="gradient-text drop-shadow-[0_0_20px_rgba(0,242,255,0.2)]">{t('certifications.title_span')}</span>
        </h1>
        <p class="text-on-surface-variant text-lg leading-relaxed max-w-2xl font-light">
            {t('certifications.description')}
        </p>
      </div>
    </section>

    <!-- Certifications Grid -->
    <section class="px-6 pb-40 max-w-screen-2xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {certifications.map((cert) => (
          <div class={`group bg-surface-container rounded-3xl border border-outline-variant/10 hover-glow-${cert.color} transition-all duration-500 overflow-hidden flex flex-col md:flex-row relative`}>
            <div class="p-10 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-8">
                  <div class={`px-3 py-1 rounded bg-${cert.color}/10 border border-${cert.color}/20 text-${cert.color} text-[10px] font-mono font-bold tracking-[0.2em] uppercase`}>
                    {cert.status.replace('_', ' ')}
                  </div>
                  <div class="text-[9px] font-label text-on-surface-variant uppercase tracking-widest opacity-60 font-black">{cert.issuer}</div>
                </div>
                <h3 class="font-headline text-3xl font-bold mb-6 tracking-tight group-hover:text-glow-primary transition-colors">{cert.title}</h3>
                <p class="text-on-surface-variant text-sm leading-relaxed mb-10 opacity-80 font-light">
                  {cert.description}
                </p>
              </div>
              <a href={cert.link} target="_blank" class={`inline-flex items-center gap-3 text-[10px] font-headline font-black text-on-surface hover:text-${cert.color} uppercase tracking-[0.3em] transition-all group/link`}>
                {t('certifications.cta_verify')}
                <span class="material-symbols-outlined text-sm group-hover/link:translate-x-3 transition-transform">fingerprint</span>
              </a>
            </div>
            {cert.badge && (
              <div class="md:w-56 bg-surface-container-high/30 flex items-center justify-center p-10 border-t md:border-t-0 md:border-l border-outline-variant/5">
                <img 
                    src={`${import.meta.env.BASE_URL}${cert.badge}`} 
                    alt={cert.title} 
                    class="w-24 h-24 object-contain filter group-hover:drop-shadow-[0_0_20px_rgba(255,255,255,0.15)] transition-all grayscale group-hover:grayscale-0 duration-700"
                />
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Roadmap -->
    <section class="max-w-screen-2xl mx-auto px-6 py-32 border-t border-outline-variant/10 bg-surface-container-low/20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
            <div>
                <h2 class="font-headline text-4xl font-bold mb-10 tracking-tight leading-tight">{t('certifications.roadmap_title')} <br/> <span class="gradient-text">{t('certifications.roadmap_span')}</span></h2>
                <div class="space-y-8">
                    <div class="flex gap-8 items-start group">
                        <div class="w-10 h-10 rounded-2xl bg-primary/10 flex items-center justify-center text-primary font-mono text-sm flex-shrink-0 border border-primary/20 group-hover:bg-primary group-hover:text-on-primary transition-all duration-300">01</div>
                        <div>
                            <h4 class="font-headline font-bold text-base uppercase tracking-wider mb-2">Maestro Cloud</h4>
                            <p class="text-sm text-on-surface-variant leading-relaxed opacity-70">Enfoque en AWS Solutions Architect Professional para dominar la orquestación de infraestructura a gran escala.</p>
                        </div>
                    </div>
                    <div class="flex gap-8 items-start group">
                        <div class="w-10 h-10 rounded-2xl bg-secondary/10 flex items-center justify-center text-secondary font-mono text-sm flex-shrink-0 border border-secondary/20 group-hover:bg-secondary group-hover:text-on-secondary transition-all duration-300">02</div>
                        <div>
                            <h4 class="font-headline font-bold text-base uppercase tracking-wider mb-2">Centinela de Seguridad</h4>
                            <p class="text-sm text-on-surface-variant leading-relaxed opacity-70">Avanzando hacia la especialización en DevSecOps con enfoque en modelado de amenazas automatizado y gobernanza IAM.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-6">
                <div class="glass-panel p-10 rounded-3xl border border-outline-variant/5 text-center group hover-glow-primary transition-all">
                    <div class="text-5xl font-headline font-black text-primary mb-2 group-hover:text-glow-primary transition-all">3+</div>
                    <div class="text-[9px] font-label text-outline uppercase tracking-[0.3em] opacity-60">Nodos_Verificados</div>
                </div>
                <div class="glass-panel p-10 rounded-3xl border border-outline-variant/5 text-center group hover-glow-secondary transition-all">
                    <div class="text-5xl font-headline font-black text-secondary mb-2 group-hover:text-glow-secondary transition-all">10k+</div>
                    <div class="text-[9px] font-label text-outline uppercase tracking-[0.3em] opacity-60">Learning_Ops_v</div>
                </div>
            </div>
        </div>
    </section>
  </main>
</Layout>
