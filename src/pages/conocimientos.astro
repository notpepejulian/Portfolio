---
import Layout from "../layouts/Layout.astro";
import { useTranslations, defaultLang } from "../utils/i18n";
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = Astro.currentLocale || defaultLang;
const t = useTranslations(lang);

const skills = [
  { id: "cloud",        tag: "#Cloud & AWS",        image: "cloud_thumb.png",          color: "primary"   },
  { id: "containers",   tag: "#Docker & K8s",       image: "containers_thumb.png",     color: "secondary" },
  { id: "cicd",         tag: "#CI/CD & GitOps",     image: "cicd_thumb.png",           color: "tertiary"  },
  { id: "linux",        tag: "#Linux & Seguridad",  image: "linux_security_thumb.png", color: "accent"    },
  { id: "databases",    tag: "#Bases de Datos",     image: "databases_thumb.png",      color: "primary"   },
  { id: "languages",    tag: "#Lenguajes",          image: "languages_thumb.png",      color: "secondary" },
];

const tagColorMap: Record<string, string> = {
  primary:   "#00f2ff",
  secondary: "#7000ff",
  tertiary:  "#00ff95",
  accent:    "#ff00e5",
};
---

<Layout title="Nacho Sánchez | Conocimientos">
  <main class="pt-24 min-h-screen">
    <!-- Header -->
    <section class="max-w-screen-2xl mx-auto px-6 py-20 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-[600px] h-px bg-gradient-to-r from-primary/40 to-transparent"></div>
      <div class="max-w-3xl">
        <p class="font-label text-xs tracking-[0.4em] text-primary uppercase mb-6 opacity-80">{t('knowledge.label')}</p>
        <h1 class="font-headline text-5xl md:text-7xl font-bold tracking-tighter leading-none mb-8">
          {t('knowledge.title')} <span class="gradient-text drop-shadow-[0_0_20px_rgba(0,242,255,0.2)]">{t('knowledge.title_span')}</span>
        </h1>
        <p class="text-on-surface-variant text-lg leading-relaxed max-w-2xl font-light">
          {t('knowledge.description')}
        </p>
      </div>
    </section>

    <!-- Skills Bento Grid -->
    <section class="px-6 pb-40">
      <div class="max-w-screen-2xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {skills.map((skill, index) => {
          const tagColor = tagColorMap[skill.color] || "#00f2ff";
          return (
            <div class={`group bg-surface-container rounded-3xl border border-outline-variant/10 hover-glow-${skill.color} transition-all duration-500 flex flex-col min-h-[380px] relative overflow-hidden`}>
              <!-- Thumbnail -->
              <div class="h-48 relative overflow-hidden rounded-t-3xl">
                <img
                  src={`${import.meta.env.BASE_URL}conocimientos/${skill.image}`}
                  alt={skill.id}
                  class="w-full h-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0 group-hover:scale-110"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container via-transparent to-transparent"></div>
              </div>

              <!-- Content -->
              <div class="p-8 pt-4 flex-1 flex flex-col justify-between relative z-10">
                <div class="flex items-center justify-between mb-6">
                  <span
                    class="text-[9px] font-mono font-black tracking-widest px-3 py-1 rounded border"
                    style={`color: ${tagColor}; background-color: ${tagColor}1a; border-color: ${tagColor}66;`}
                  >
                    {skill.tag}
                  </span>
                  <span class="text-on-surface-variant/20 font-headline text-2xl font-bold italic">0{index + 1}</span>
                </div>
                <h3 class="font-headline text-xl font-bold tracking-tight group-hover:text-glow-primary transition-colors">
                  {t(`knowledge.skill_${skill.id}`)}
                </h3>
              </div>
            </div>
          );
        })}
      </div>

      <section class="max-w-screen-2xl mx-auto px-6 py-40">
      <div class="max-w-3xl">
        <p class="font-label text-xs tracking-[0.3em] text-primary uppercase mb-6 opacity-80">{t('knowledge.operational_label')}</p>
        <h1 class=" font-headline text-5xl md:text-7xl font-bold tracking-tighter leading-none mb-8">
          {t('knowledge.strategy_title')} <span class="gradient-text-alt">{t('knowledge.strategy_span')}</span>
        </h1>
      </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
            <div class="order-2 lg:order-1">
                <div class="glass-panel p-1 rounded-3xl overflow-hidden shadow-2xl relative group">
                    <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-secondary/10 to-tertiary/10 opacity-50"></div>
                    <div class="relative bg-surface-container/90 rounded-[1.4rem] p-10 font-mono text-xs leading-relaxed">
                        <div class="flex gap-2 mb-8 border-b border-outline-variant/10 pb-4">
                            <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
                            <div class="ml-4 opacity-40">ops@edge: ~/provisioning</div>
                        </div>
                        <div class="space-y-4">
                            <div class="flex gap-4">
                                <span class="text-primary">$</span>
                                <span class="text-on-surface">terraform apply --auto-approve</span>
                            </div>
                            <div class="text-tertiary ml-8">Plan: 4 to add, 0 to change, 0 to destroy.</div>
                            <div class="text-on-surface-variant ml-8">aws_eks_cluster.main: Creating...</div>
                            <div class="text-on-surface-variant ml-8">aws_iam_role.eks: Creating...</div>
                            <div class="flex gap-4 pt-4">
                                <span class="text-primary">$</span>
                                <span class="text-on-surface">kubectl get pods -n production</span>
                            </div>
                            <div class="flex gap-8 ml-8 text-on-surface-variant">
                                <span>NAME</span>
                                <span>STATUS</span>
                                <span>AGE</span>
                            </div>
                            <div class="flex gap-8 ml-8 text-green-400">
                                <span>api-v2-7k92</span>
                                <span>Running</span>
                                <span>24d</span>
                            </div>
                            <div class="flex gap-8 ml-8 text-green-400">
                                <span>worker-6f4s</span>
                                <span>Running</span>
                                <span>12d</span>
                            </div>
                        </div>
                    </div>
                    <!-- Glow effect on hover -->
                    <div class="absolute -inset-1 bg-gradient-to-r from-primary via-secondary to-tertiary rounded-3xl blur opacity-0 group-hover:opacity-20 transition duration-1000 -z-10"></div>
                </div>
            </div>
            <div class="order-1 lg:order-2">
                <p class="font-label text-xs tracking-[0.4em] text-tertiary uppercase mb-4">{t('knowledge.strategy_label')}</p>
                <h2 class="font-headline text-3xl font-bold tracking-tighter mb-8 leading-tight">{t('knowledge.ops')} <span class="gradient-text-alt">{t('knowledge.ops_span')}</span> & <span class="gradient-text-alt">{t('knowledge.ops_vcs_span')}</span></h2>
                <p class="text-on-surface-variant text-lg leading-relaxed mb-10 font-light">
                    {t('knowledge.strategy_desc')}
                </p>
                 <div class="flex flex-wrap gap-8">
                    <div class="group">
                        <div class="text-3xl font-headline font-bold text-on-surface mb-1 group-hover:text-primary transition-colors">100%</div>
                        <div class="text-[9px] font-mono text-outline uppercase tracking-[0.3em]">{t('knowledge.stat_iac')}</div>
                    </div>
                    <div class="w-px h-10 bg-outline-variant/20 hidden sm:block"></div>
                    <div class="group">
                        <div class="text-3xl font-headline font-bold text-on-surface mb-1 group-hover:text-secondary transition-colors">Team Work</div>
                        <div class="text-[9px] font-mono text-outline uppercase tracking-[0.3em]">{t('knowledge.stat_drift')}</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
  </main>
</Layout>
