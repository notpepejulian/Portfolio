---
import Layout from "../layouts/Layout.astro";
import { useTranslations, defaultLang } from "../utils/i18n";

const url = new URL(Astro.request.url);
const lang = url.searchParams.get('lang') || defaultLang;
const t = useTranslations(lang);

const skills = [
  { category: "Cloud e Infraestructura", icon: "cloud", items: ["AWS", "Terraform", "Azure", "GCP"], color: "primary" },
  { category: "Contenedores y Orquestación", icon: "package", items: ["Docker", "Kubernetes", "HELM", "Rancher"], color: "secondary" },
  { category: "Automatización y CI/CD", icon: "terminal", items: ["Jenkins", "GitHub Actions", "Ansible", "ArgoCD"], color: "tertiary" },
  { category: "Linux y Seguridad", icon: "shield", items: ["RHEL", "Bash", "Hardening", "Wazuh"], color: "accent" },
  { category: "Bases de Datos y Almacenamiento", icon: "database", items: ["PostgreSQL", "MongoDB", "Redis", "S3"], color: "primary" },
  { category: "Desarrollo y Web", icon: "code", items: ["Node.js", "Python", "Astro", "Tailwind"], color: "secondary" }
];
---

<Layout title="Nacho Sánchez | Knowledge Graph" lang={lang}>
  <main class="pt-24 min-h-screen">
    <!-- Hero Section -->
    <section class="max-w-screen-2xl mx-auto px-6 py-20 relative overflow-hidden">
      <div class="max-w-3xl">
        <p class="font-label text-xs tracking-[0.3em] text-primary uppercase mb-6 opacity-80">{t('knowledge.label')}</p>
        <h1 class="font-headline text-5xl md:text-7xl font-bold tracking-tighter leading-none mb-8">
          {t('knowledge.title')} <span class="gradient-text drop-shadow-[0_0_20px_rgba(0,242,255,0.2)]">{t('knowledge.title_span')}</span>
        </h1>
        <p class="text-on-surface-variant text-lg leading-relaxed mb-10 max-w-2xl font-light">
          {t('knowledge.description')}
        </p>
      </div>
    </section>

    <!-- Tech Stack Bento Grid -->
    <section class="px-6 py-20 bg-surface-container-low/30 border-y border-outline-variant/10">
      <div class="max-w-screen-2xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {skills.map((skill) => (
            <div class={`group bg-surface-container p-8 rounded-3xl border border-outline-variant/10 hover-glow-${skill.color} transition-all duration-500 overflow-hidden relative`}>
              <div class="flex items-center gap-4 mb-8">
                <div class={`w-12 h-12 rounded-2xl bg-${skill.color}/10 flex items-center justify-center text-${skill.color} border border-${skill.color}/20 group-hover:bg-${skill.color} group-hover:text-on-primary transition-all duration-500`}>
                  <span class="material-symbols-outlined text-xl">{skill.icon}</span>
                </div>
                <h3 class="font-headline text-xl font-bold tracking-tight">{skill.category}</h3>
              </div>
              <div class="flex flex-wrap gap-2">
                {skill.items.map(item => (
                  <span class="px-3 py-1.5 bg-surface-container-high/50 text-[10px] font-mono font-bold text-on-surface-variant uppercase rounded border border-outline-variant/10 group-hover:border-primary/20 transition-colors">
                    {item}
                  </span>
                ))}
              </div>
              <!-- Decorative background icon -->
              <div class="absolute -bottom-4 -right-4 opacity-[0.03] group-hover:opacity-[0.07] transition-opacity duration-700">
                <span class="material-symbols-outlined text-9xl">{skill.icon}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Operational Methodology -->
    <section class="max-w-screen-2xl mx-auto px-6 py-40">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
            <div class="order-2 lg:order-1">
                <div class="glass-panel p-1 rounded-3xl overflow-hidden shadow-2xl relative group">
                    <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-secondary/10 to-tertiary/10 opacity-50"></div>
                    <div class="relative bg-surface-container/90 rounded-[1.4rem] p-10 font-mono text-xs leading-relaxed">
                        <div class="flex gap-2 mb-8 border-b border-outline-variant/10 pb-4">
                            <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
                            <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
                            <div class="ml-4 opacity-40">ops@edge: ~/provisioning</div>
                        </div>
                        <div class="space-y-4">
                            <div class="flex gap-4">
                                <span class="text-primary">$</span>
                                <span class="text-on-surface">terraform apply --auto-approve</span>
                            </div>
                            <div class="text-tertiary ml-8">Plan: 4 to add, 0 to change, 0 to destroy.</div>
                            <div class="text-on-surface-variant ml-8">aws_eks_cluster.main: Creating...</div>
                            <div class="text-on-surface-variant ml-8">aws_iam_role.eks: Creating...</div>
                            <div class="flex gap-4 pt-4">
                                <span class="text-primary">$</span>
                                <span class="text-on-surface">kubectl get pods -n production</span>
                            </div>
                            <div class="flex gap-8 ml-8 text-on-surface-variant">
                                <span>NAME</span>
                                <span>STATUS</span>
                                <span>AGE</span>
                            </div>
                            <div class="flex gap-8 ml-8 text-green-400">
                                <span>api-v2-7k92</span>
                                <span>Running</span>
                                <span>24d</span>
                            </div>
                            <div class="flex gap-8 ml-8 text-green-400">
                                <span>worker-6f4s</span>
                                <span>Running</span>
                                <span>12d</span>
                            </div>
                        </div>
                    </div>
                    <!-- Glow effect on hover -->
                    <div class="absolute -inset-1 bg-gradient-to-r from-primary via-secondary to-tertiary rounded-3xl blur opacity-0 group-hover:opacity-20 transition duration-1000 -z-10"></div>
                </div>
            </div>
            <div class="order-1 lg:order-2">
                <p class="font-label text-xs tracking-[0.4em] text-tertiary uppercase mb-4">{t('knowledge.strategy_label')}</p>
                <h2 class="font-headline text-5xl font-bold tracking-tighter mb-8 leading-tight">{t('knowledge.strategy_title')} <br/> <span class="gradient-text-alt">{t('knowledge.strategy_span')}</span></h2>
                <p class="text-on-surface-variant text-lg leading-relaxed mb-10 font-light">
                    {t('knowledge.strategy_desc')}
                </p>
                <div class="flex flex-wrap gap-8">
                    <div class="group">
                        <div class="text-3xl font-headline font-bold text-on-surface mb-1 group-hover:text-primary transition-colors">100%</div>
                        <div class="text-[9px] font-mono text-outline uppercase tracking-[0.3em]">IaC_Versioned</div>
                    </div>
                    <div class="w-px h-10 bg-outline-variant/20 hidden sm:block"></div>
                    <div class="group">
                        <div class="text-3xl font-headline font-bold text-on-surface mb-1 group-hover:text-secondary transition-colors">Zero</div>
                        <div class="text-[9px] font-mono text-outline uppercase tracking-[0.3em]">Manual_Drift</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
  </main>
</Layout>
