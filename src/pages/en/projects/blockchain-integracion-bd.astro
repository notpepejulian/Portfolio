---
import { useTranslations, defaultLang } from "../../../utils/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
const lang = Astro.currentLocale || defaultLang;
const t = useTranslations(lang);
import Layout from "../../../layouts/Layout.astro";
---

<style>
	html {
		scroll-behavior: smooth;
	}

	/* Animación de tecnologías desplazándose */
	@keyframes scroll {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	.tech-scroll {
		animation: scroll 30s linear infinite;
	}

	.tech-scroll:hover {
		animation-play-state: paused;
	}

	.tech-container {
		overflow: hidden;
		mask-image: linear-gradient(
			to right,
			transparent,
			black 10%,
			black 90%,
			transparent
		);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent,
			black 10%,
			black 90%,
			transparent
		);
	}
</style>

<Layout>
	<main
		class="flex flex-col min-h-screen items-center justify-center px-6 py-20 bg-transparent relative"
	>
		<div class="max-w-4xl w-full text-center z-10">
            <div
                class="inline-flex items-center gap-4 px-4 py-1.5 border border-emerald-400/20 rounded bg-emerald-500/10 mb-6"
            >
                <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"
                ></span>
                <span class="text-emerald-300 font-mono text-[10px] tracking-widest uppercase font-bold"
                    >In Production</span
                >
            </div>
            <h1
                class="font-headline text-5xl md:text-7xl font-bold tracking-tighter bg-gradient-to-r from-fuchsia-400 via-pink-400 to-purple-400 bg-clip-text text-transparent mb-6"
            >
                MySQL-BigchainDB
            </h1>
            <p class="text-xl sm:text-2xl font-light text-on-surface-variant mb-6">
                MySQL and BigchainDB Integration with REST API and Tendermint
            </p>
            <p
                class="text-lg text-on-surface-variant font-light mb-10 max-w-2xl mx-auto leading-relaxed"
            >
                REST API designed to integrate a MySQL relational database with BigchainDB, providing fast and secure storage combined with immutability and traceability.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
                <a
                    href="https://github.com/notpepejulian/MySQL-BigchainDB"
                    target="_blank"
                    class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-fuchsia-600 hover:bg-fuchsia-500 text-white font-headline tracking-wider uppercase text-xs shadow-lg transition-all duration-200 group"
                >
                    <span>View on GitHub</span>
                </a>
                <a
                    href={getRelativeLocaleUrl(lang, 'projects/')}
                    class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-fuchsia-300 font-headline tracking-wider uppercase text-xs shadow-lg transition-all duration-200 border border-fuchsia-400/30"
                >
                    {t('projects.back')}
                </a>
            </div>
		</div>
	</main>

	<section class="mt-10 mb-40 w-full flex flex-col items-center px-6">
		<div class="w-full max-w-6xl mx-auto space-y-24">
			<!-- Arquitectura -->
			<div>
				<h2
					class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-fuchsia-400 via-pink-400 to-purple-400 mb-8 text-center"
				>
					Project Architecture
				</h2>
				<div class="max-w-5xl mx-auto">
					<div class="grid md:grid-cols-2 gap-6">
						<div
							class="group bg-surface-container-low/40 hover:bg-surface-container/80 transition-all duration-300 border border-fuchsia-400/20 rounded-[2rem] p-6 hover-glow-purple backdrop-blur-md relative overflow-hidden"
						>
							<div class="flex items-center gap-3 mb-4">
								<div
									class="w-12 h-12 rounded-full bg-fuchsia-500/20 flex items-center justify-center"
								>
									<span class="material-symbols-outlined text-fuchsia-400">dns</span>
								</div>
								<h3 class="text-xl font-bold text-fuchsia-300">
									API REST
								</h3>
							</div>
							<p class="text-gray-300 text-sm mb-3">
								<strong class="text-fuchsia-300"
