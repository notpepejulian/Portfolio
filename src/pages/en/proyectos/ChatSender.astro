---
import { useTranslations, defaultLang } from "../../../utils/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
const lang = Astro.currentLocale || defaultLang;
const t = useTranslations(lang);
import Layout from "../../../layouts/Layout.astro";
---

<style>
    html {
        scroll-behavior: smooth;
    }

    /* Animación de tecnologías desplazándose */
    @keyframes scroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }

    .tech-scroll {
        animation: scroll 30s linear infinite;
    }

    .tech-scroll:hover {
        animation-play-state: paused;
    }

    .tech-container {
        overflow: hidden;
        mask-image: linear-gradient(
            to right,
            transparent,
            black 10%,
            black 90%,
            transparent
        );
        -webkit-mask-image: linear-gradient(
            to right,
            transparent,
            black 10%,
            black 90%,
            transparent
        );
    }
</style>

<Layout>
    <main
        class="flex flex-col min-h-screen items-center justify-center px-6 py-20 bg-transparent relative"
    >
        <div class="max-w-4xl w-full text-center z-10">
            <div
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-yellow-500/20 border border-yellow-400/30 mb-6"
            >
                <span class="h-2 w-2 rounded-full bg-yellow-400 animate-pulse"
                ></span>
                <span class="text-yellow-300 font-semibold text-sm"
                    >{t('projects.in_progress')}</span
                >
            </div>
            <h1
                class="text-6xl sm:text-7xl font-black bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent mb-6 tracking-tight"
            >
                ChatSender
            </h1>
            <p class="text-xl sm:text-2xl font-medium text-white/80 mb-6">
                Mensajería Anónima con Autenticación Criptográfica
                Zero-Knowledge
            </p>
            <p
                class="text-lg text-gray-300 mb-10 max-w-2xl mx-auto leading-relaxed"
            >
                Plataforma de comunicación ultra-privada que elimina la
                necesidad de datos personales, utilizando identidades basadas en
                llaves Ed25519 y el protocolo Matrix para cifrado E2EE.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
                <a
                    href="https://github.com/notpepejulian/SecChat"
                    target="_blank"
                    class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-blue-600 hover:bg-blue-500 text-white font-semibold shadow-lg transition-all duration-200 text-base group"
                >
                    <i class="fa-brands fa-github mr-2"></i>
                    <span>Ver en GitHub</span>
                    <i
                        class="fa-solid fa-arrow-up-right-from-square ml-2 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
                    ></i>
                </a>
                <a
                    href={getRelativeLocaleUrl(lang, 'proyectos/')}
                    class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-blue-300 font-semibold shadow-lg transition-all duration-200 text-base border border-blue-400/30"
                >
                    <i class="fa-solid fa-arrow-left mr-2"></i>
                    {t('projects.back')}
                </a>
            </div>
        </div>
    </main>

    <section class="mt-10 mb-40 w-full flex flex-col items-center px-6">
        <div class="w-full max-w-6xl mx-auto space-y-24">
            <!-- Arquitectura -->
            <div>
                <h2
                    class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 mb-8 text-center"
                >
                    Arquitectura de Seguridad
                </h2>
                <div class="max-w-5xl mx-auto">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div
                            class="bg-gradient-to-br from-blue-900/20 to-slate-900/40 border border-blue-400/20 rounded-xl p-6 backdrop-blur-sm"
                        >
                            <div class="flex items-center gap-3 mb-4">
                                <div
                                    class="w-12 h-12 rounded-lg bg-blue-500/20 flex items-center justify-center"
                                >
                                    <i
                                        class="fa-solid fa-user-secret text-2xl text-blue-400"
                                    ></i>
                                </div>
                                <h3 class="text-xl font-bold text-blue-300">
                                    Auth Zero-Knowledge
                                </h3>
                            </div>
                            <p class="text-gray-300 text-sm mb-3">
                                <strong class="text-blue-300"
                                    >Firmas Ed25519</strong
                                >
                            </p>
                            <ul class="text-gray-300 text-sm space-y-1.5">
                                <li class="flex items-start gap-2">
                                    <span class="text-blue-400 mt-1">•</span>
                                    <span
                                        >Sin contraseñas, emails ni teléfonos</span
                                    >
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-blue-400 mt-1">•</span>
                                    <span
                                        >Identidad basada en llaves
                                        públicas/privadas</span
                                    >
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-blue-400 mt-1">•</span>
                                    <span>Challenge-Response en el cliente</span
                                    >
                                </li>
                            </ul>
                        </div>

                        <div
                            class="bg-gradient-to-br from-purple-900/20 to-slate-900/40 border border-purple-400/20 rounded-xl p-6 backdrop-blur-sm"
                        >
                            <div class="flex items-center gap-3 mb-4">
                                <div
                                    class="w-12 h-12 rounded-lg bg-purple-500/20 flex items-center justify-center"
                                >
                                    <i
                                        class="fa-solid fa-network-wired text-2xl text-purple-400"
                                    ></i>
                                </div>
                                <h3 class="text-xl font-bold text-purple-300">
                                    Matrix Synapse
                                </h3>
                            </div>
                            <p class="text-gray-300 text-sm mb-3">
                                <strong class="text-purple-300"
                                    >Motor de Mensajería</strong
                                >
                            </p>
                            <ul class="text-gray-300 text-sm space-y-1.5">
                                <li class="flex items-start gap-2">
                                    <span class="text-purple-400 mt-1">•</span>
                                    <span
                                        >Cifrado de Extremo a Extremo (E2EE)</span
                                    >
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-purple-400 mt-1">•</span>
                                    <span>Despliegue Federado u Omnicanal</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-purple-400 mt-1">•</span>
                                    <span>Persistencia en MariaDB / Redis</span>
                                </li>
                            </ul>
                        </div>

                        <div
                            class="bg-gradient-to-br from-emerald-900/20 to-slate-900/40 border border-emerald-400/20 rounded-xl p-6 backdrop-blur-sm"
                        >
                            <div class="flex items-center gap-3 mb-4">
                                <div
                                    class="w-12 h-12 rounded-lg bg-emerald-500/20 flex items-center justify-center"
                                >
                                    <i
                                        class="fa-solid fa-shield-halved text-2xl text-emerald-400"
                                    ></i>
                                </div>
                                <h3 class="text-xl font-bold text-emerald-300">
                                    Infraestructura
                                </h3>
                            </div>
                            <p class="text-gray-300 text-sm mb-3">
                                <strong class="text-emerald-300"
                                    >Seguridad en Capas</strong
                                >
                            </p>
                            <ul class="text-gray-300 text-sm space-y-1.5">
                                <li class="flex items-start gap-2">
                                    <span class="text-emerald-400 mt-1">•</span>
                                    <span>WireGuard VPN integrada</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-emerald-400 mt-1">•</span>
                                    <span>Políticas SELinux restrictivas</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-emerald-400 mt-1">•</span>
                                    <span>Proxy inverso seguro con Nginx</span>
                                </li>
                            </ul>
                        </div>

                        <div
                            class="bg-gradient-to-br from-pink-900/20 to-slate-900/40 border border-pink-400/20 rounded-xl p-6 backdrop-blur-sm"
                        >
                            <div class="flex items-center gap-3 mb-4">
                                <div
                                    class="w-12 h-12 rounded-lg bg-pink-500/20 flex items-center justify-center"
                                >
                                    <i
                                        class="fa-solid fa-microchip text-2xl text-pink-400"
                                    ></i>
                                </div>
                                <h3 class="text-xl font-bold text-pink-300">
                                    Tecnologías
                                </h3>
                            </div>
                            <p class="text-gray-300 text-sm mb-3">
                                <strong class="text-pink-300"
                                    >Stack Moderno</strong
                                >
                            </p>
                            <ul class="text-gray-300 text-sm space-y-1.5">
                                <li class="flex items-start gap-2">
                                    <span class="text-pink-400 mt-1">•</span>
                                    <span>Backend con FastAPI (Python)</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-pink-400 mt-1">•</span>
                                    <span>Frontend con Astro & Tailwind</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-pink-400 mt-1">•</span>
                                    <span>Contenerización con Docker</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Flujo de Seguridad -->
            <div>
                <h2
                    class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 mb-8 text-center"
                >
                    Flujo de Conexión Segura
                </h2>
                <div class="max-w-4xl mx-auto">
                    <div
                        class="bg-gradient-to-br from-slate-900/40 to-slate-800/40 border border-blue-400/20 rounded-xl p-8 backdrop-blur-sm"
                    >
                        <div class="space-y-8">
                            <div>
                                <div class="flex items-center gap-3 mb-4">
                                    <div
                                        class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center"
                                    >
                                        <span class="text-blue-400 font-bold"
                                            >1</span
                                        >
                                    </div>
                                    <h3 class="text-xl font-bold text-blue-300">
                                        Generación de Identidad
                                    </h3>
                                </div>
                                <div class="ml-14 space-y-2 text-gray-300">
                                    <p class="flex items-start gap-2">
                                        <span class="text-blue-400 mt-1">·</span
                                        >
                                        <span
                                            >El usuario genera un par de llaves
                                            Ed25519 localmente mediante <code
                                                class="bg-blue-900/50 px-2 py-0.5 rounded text-blue-300 text-sm"
                                                >keygen.sh</code
                                            ></span
                                        >
                                    </p>
                                    <p class="flex items-start gap-2">
                                        <span class="text-blue-400 mt-1">·</span
                                        >
                                        <span
                                            >La llave privada NUNCA sale del
                                            dispositivo del usuario</span
                                        >
                                    </p>
                                </div>
                            </div>

                            <div class="border-t border-blue-400/20 pt-8">
                                <div class="flex items-center gap-3 mb-4">
                                    <div
                                        class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center"
                                    >
                                        <span class="text-blue-400 font-bold"
                                            >2</span
                                        >
                                    </div>
                                    <h3 class="text-xl font-bold text-blue-300">
                                        Handshake Criptográfico
                                    </h3>
                                </div>
                                <p class="ml-14 text-gray-300">
                                    El servidor envía un desafío aleatorio. El
                                    cliente lo firma con su llave privada. El
                                    servidor verifica la firma con la llave
                                    pública almacenada.
                                </p>
                            </div>

                            <div class="border-t border-blue-400/20 pt-8">
                                <div class="flex items-center gap-3 mb-4">
                                    <div
                                        class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center"
                                    >
                                        <span class="text-blue-400 font-bold"
                                            >3</span
                                        >
                                    </div>
                                    <h3 class="text-xl font-bold text-blue-300">
                                        Mensajería Efímera
                                    </h3>
                                </div>
                                <p class="ml-14 text-gray-300">
                                    Una vez autenticado, los mensajes fluyen
                                    cifrados vía Matrix. El sistema soporta
                                    autodestrucción y no almacena logs de acceso
                                    ni direcciones IP.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tecnologías Empleadas -->
            <div>
                <h2
                    class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 mb-8 text-center"
                >
                    Stack del Proyecto
                </h2>
                <div class="tech-container">
                    <div class="flex tech-scroll gap-8">
                        <!-- Primera copia -->
                        <div class="flex gap-8 flex-shrink-0">
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-blue-900/30 to-slate-900/50 border border-blue-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-brands fa-python text-5xl text-blue-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-blue-300 font-medium text-center"
                                    >FastAPI</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-purple-900/30 to-slate-900/50 border border-purple-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-solid fa-comments text-5xl text-purple-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-purple-300 font-medium text-center"
                                    >Matrix</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-blue-900/30 to-slate-900/50 border border-blue-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-brands fa-js text-5xl text-yellow-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-yellow-300 font-medium text-center"
                                    >Astro</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-emerald-900/30 to-slate-900/50 border border-emerald-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-brands fa-docker text-5xl text-emerald-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-emerald-300 font-medium text-center"
                                    >Docker</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-blue-900/30 to-slate-900/50 border border-blue-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-solid fa-vial-lock text-5xl text-blue-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-blue-300 font-medium text-center"
                                    >WireGuard</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-blue-900/30 to-slate-900/50 border border-blue-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-solid fa-key text-5xl text-blue-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-blue-300 font-medium text-center"
                                    >Ed25519</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-emerald-900/30 to-slate-900/50 border border-emerald-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-solid fa-database text-5xl text-emerald-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-emerald-300 font-medium text-center"
                                    >MariaDB</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-pink-900/30 to-slate-900/50 border border-pink-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-solid fa-bolt text-5xl text-pink-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-pink-300 font-medium text-center"
                                    >Redis</span
                                >
                            </div>
                        </div>
                        <!-- Segunda copia para loop infinito -->
                        <div class="flex gap-8 flex-shrink-0">
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-blue-900/30 to-slate-900/50 border border-blue-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-brands fa-python text-5xl text-blue-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-blue-300 font-medium text-center"
                                    >FastAPI</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-purple-900/30 to-slate-900/50 border border-purple-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-solid fa-comments text-5xl text-purple-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-purple-300 font-medium text-center"
                                    >Matrix</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-blue-900/30 to-slate-900/50 border border-blue-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-brands fa-js text-5xl text-yellow-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-yellow-300 font-medium text-center"
                                    >Astro</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-emerald-900/30 to-slate-900/50 border border-emerald-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-brands fa-docker text-5xl text-emerald-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-emerald-300 font-medium text-center"
                                    >Docker</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-blue-900/30 to-slate-900/50 border border-blue-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-solid fa-vial-lock text-5xl text-blue-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-blue-300 font-medium text-center"
                                    >WireGuard</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-blue-900/30 to-slate-900/50 border border-blue-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-solid fa-key text-5xl text-blue-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-blue-300 font-medium text-center"
                                    >Ed25519</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-emerald-900/30 to-slate-900/50 border border-emerald-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-solid fa-database text-5xl text-emerald-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-emerald-300 font-medium text-center"
                                    >MariaDB</span
                                >
                            </div>
                            <div
                                class="flex flex-col items-center justify-center w-32 bg-gradient-to-br from-pink-900/30 to-slate-900/50 border border-pink-400/20 rounded-xl backdrop-blur-sm p-4"
                            >
                                <i
                                    class="fa-solid fa-bolt text-5xl text-pink-400 mb-2"
                                ></i>
                                <span
                                    class="text-xs text-pink-300 font-medium text-center"
                                    >Redis</span
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Características Principales -->
            <div>
                <h2
                    class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 mb-8 text-center"
                >
                    Características de Privacidad
                </h2>
                <div class="max-w-4xl mx-auto">
                    <div class="grid md:grid-cols-3 gap-6 mt-8">
                        <div
                            class="bg-gradient-to-br from-blue-900/20 to-slate-900/40 border border-blue-400/20 rounded-xl p-6 backdrop-blur-sm"
                        >
                            <div class="text-blue-400 text-3xl mb-3">
                                <i class="fa-solid fa-user-slash"></i>
                            </div>
                            <h3
                                class="text-blue-300 font-semibold text-lg mb-2"
                            >
                                Identidad Efímera
                            </h3>
                            <p class="text-gray-300 text-sm leading-relaxed">
                                Las identidades pueden ser temporales y no están
                                vinculadas a ninguna base de datos centralizada.
                            </p>
                        </div>
                        <div
                            class="bg-gradient-to-br from-purple-900/20 to-slate-900/40 border border-purple-400/20 rounded-xl p-6 backdrop-blur-sm"
                        >
                            <div class="text-purple-400 text-3xl mb-3">
                                <i class="fa-solid fa-mask"></i>
                            </div>
                            <h3
                                class="text-purple-300 font-semibold text-lg mb-2"
                            >
                                Anti-Tracking
                            </h3>
                            <p class="text-gray-300 text-sm leading-relaxed">
                                Ofuscación de metadatos y protección contra
                                fingerprinting de red.
                            </p>
                        </div>
                        <div
                            class="bg-gradient-to-br from-pink-900/20 to-slate-900/40 border border-pink-400/20 rounded-xl p-6 backdrop-blur-sm"
                        >
                            <div class="text-pink-400 text-3xl mb-3">
                                <i class="fa-solid fa-trash-can"></i>
                            </div>
                            <h3
                                class="text-pink-300 font-semibold text-lg mb-2"
                            >
                                Autodestrucción
                            </h3>
                            <p class="text-gray-300 text-sm leading-relaxed">
                                Borrado seguro de mensajes y chats tras un
                                periodo configurable.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botón Volver -->
            <div class="text-center pt-8">
                <a
                    href={getRelativeLocaleUrl(lang, 'proyectos/')}
