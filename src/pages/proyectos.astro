---
import Layout from "../layouts/Layout.astro";
---

<style>
  html {
    scroll-behavior: smooth;
  }
</style>

<Layout>
  <main
    class="flex flex-col min-h-screen items-center justify-center px-6 py-20 bg-transparent relative"
  >
    <div class="max-w-2xl w-full text-center z-10">
      <h1
        class="text-6xl sm:text-7xl font-black bg-gradient-to-r from-cyan-400 via-pink-400 to-yellow-300 bg-clip-text text-transparent mb-6 tracking-tight"
      >
        Proyectos
      </h1>
      <p class="text-xl sm:text-2xl font-medium text-white/80 mb-6">
        CI/CD | IA | Blockchain
      </p>
      <p class="text-lg text-gray-300 mb-10">
        Proyectos blockchain, automatización con IA, ideas de negocio,
        contenerización. Algunos ya en producción, otros en desarrollo o como
        ideas.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
        <a
          href="#proyectos"
          class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-cyan-500 hover:bg-cyan-400 text-white font-semibold shadow-lg transition-all duration-200 text-base group"
        >
          <span>Ver proyectos</span>
          <i
            class="fa-solid fa-arrow-down ml-2 group-hover:translate-y-1 transition-transform"
          ></i>
        </a>
        <a
          href={`${import.meta.env.BASE_URL}conocimientos/`}
          class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-cyan-300 font-semibold shadow-lg transition-all duration-200 text-base border border-cyan-400/30"
        >
          Conocimientos
        </a>
      </div>
    </div>
  </main>
  <style>
    .proyecto-card {
      @apply rounded-2xl shadow-2xl border bg-gradient-to-br from-slate-900/80 via-slate-800/70 to-slate-900/60 backdrop-blur-lg flex flex-col md:flex-row min-h-[220px] overflow-hidden transition-all duration-300;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    /* Borde y sombra de hover personalizado por color predominante */
    .proyecto-card.border-fuchsia-400\/30:hover {
      border-color: #d946ef !important;
      box-shadow:
        0 8px 32px 0 rgba(217, 70, 239, 0.25),
        0 0 0 2px #d946ef;
    }
    .proyecto-card.border-cyan-400\/30:hover {
      border-color: #22d3ee !important;
      box-shadow:
        0 8px 32px 0 rgba(34, 211, 238, 0.25),
        0 0 0 2px #22d3ee;
    }
    .proyecto-card.border-yellow-400\/30:hover {
      border-color: #facc15 !important;
      box-shadow:
        0 8px 32px 0 rgba(250, 204, 21, 0.25),
        0 0 0 2px #facc15;
    }
    .proyecto-card.border-emerald-400\/30:hover {
      border-color: #34d399 !important;
      box-shadow:
        0 8px 32px 0 rgba(52, 211, 153, 0.25),
        0 0 0 2px #34d399;
    }
    .proyecto-card.border-blue-400\/30:hover {
      border-color: #0c3fd8 !important;
      box-shadow:
        0 8px 32px 0 rgba(9, 51, 175, 0.25),
        0 0 0 2px #0c3fd8;
    }
    .proyecto-card.border-red-400\/30:hover {
      border-color: #d33434 !important;
      box-shadow:
        0 8px 32px 0 rgba(211, 52, 52, 0.25),
        0 0 0 2px #d33434;
    }
    .proyecto-card:hover {
      transform: scale(1.03);
    }
    /* Grid Styles */
    .proyecto-grid-item {
      @apply relative rounded-2xl overflow-hidden border border-white/10 aspect-square flex flex-col transition-all duration-500 bg-slate-900/40 backdrop-blur-md;
    }
    .proyecto-grid-item .bg-image {
      @apply absolute inset-0 bg-cover bg-center opacity-0 transition-opacity duration-500 scale-110 z-0;
    }
    .proyecto-grid-item:hover .bg-image {
      @apply opacity-30 scale-100;
    }
    .proyecto-grid-item:hover {
      border-color: var(--hover-color);
      box-shadow: 0 0 25px -5px var(--hover-color);
    }

    .grid-terminal-header {
      @apply flex items-center justify-between px-5 py-3 border-b z-10 relative;
      background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.08) 0%,
        rgba(255, 255, 255, 0.02) 100%
      );
      border-color: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(16px) saturate(180%);
      box-shadow:
        0 4px 16px rgba(0, 0, 0, 0.1),
        inset 0 1px 0 rgba(255, 255, 255, 0.1),
        inset 0 -1px 0 rgba(0, 0, 0, 0.1);
    }
    .grid-terminal-header::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.2) 50%,
        transparent
      );
    }

    .grid-terminal-content {
      @apply flex-1 flex flex-col justify-between p-6 text-center z-10 relative;
    }

    .terminal-body {
      @apply flex-1 flex flex-col items-center justify-center w-full;
    }

    .grid-project-btn {
      @apply mt-4 px-6 py-2.5 rounded-full bg-white/5 border border-white/20 text-white/80 text-sm font-mono uppercase tracking-wider transition-all duration-300 hover:bg-white/10 hover:border-white/40 hover:text-white hover:scale-105 z-10;
      backdrop-filter: blur(10px);
    }

    .status-light {
      @apply w-2 h-2 rounded-full;
      box-shadow: 0 0 8px currentColor;
    }
    .status-label {
      @apply text-[10px] tracking-widest font-mono opacity-60 mr-2;
    }
    .status-prod {
      @apply bg-green-500 text-green-500 animate-pulse;
    }
    .status-dev {
      @apply bg-yellow-500 text-yellow-500 animate-pulse;
    }
    .status-idea {
      @apply bg-purple-500 text-purple-500 animate-pulse;
    }

    /* Command Interaction Styles */
    .terminal-prompt {
      @apply flex flex-col items-start transition-all duration-500;
    }
    .terminal-output {
      @apply absolute inset-0 flex items-center justify-center p-6 opacity-0 translate-y-4 transition-all duration-500 pointer-events-none;
    }
    .proyecto-grid-item:hover .terminal-prompt {
      @apply opacity-0 -translate-y-4;
    }
    .proyecto-grid-item:hover .terminal-output {
      @apply opacity-100 translate-y-0;
    }

    .prompt-user {
      @apply text-green-400;
    }
    .prompt-host {
      @apply text-blue-400;
    }
    .prompt-dir {
      @apply text-cyan-400;
    }
    .prompt-cursor {
      @apply inline-block w-2 h-4 bg-white/60 ml-1 animate-[blink_1s_infinite];
    }

    @keyframes blink {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0;
      }
    }

    .proyecto-grid-item h3 {
      @apply font-mono font-bold text-lg text-center leading-tight;
      color: var(--hover-color);
      filter: brightness(1.2);
    }

    /* View Toggle UI */
    .view-toggle-btn {
      @apply px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-white/60 transition-all duration-200 flex items-center gap-2;
    }
    .view-toggle-btn.active {
      @apply bg-cyan-500/20 border-cyan-400/50 text-cyan-300 shadow-[0_0_15px_rgba(34,211,238,0.1)];
    }

    /* Terminal block style */
    .terminal-block {
      @apply w-full max-w-xs rounded-xl overflow-hidden shadow-lg border border-white/10;
      display: flex;
      flex-direction: column;
      background: transparent;
    }
    .terminal-header {
      @apply flex items-center px-6 py-2;
      border-bottom-width: 1px;
      border-radius: 0.75rem 0.75rem 0 0;
    }
    .terminal-content {
      @apply px-6 py-4 font-mono text-base;
      background: transparent;
    }

    .hidden {
      display: none !important;
    }
  </style>
  <section id="proyectos" class="mt-20 mb-40 w-full flex flex-col items-center">
    <div class="flex justify-center gap-4 mb-10">
      <h2
        class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-pink-400 to-yellow-300 tracking-tight drop-shadow-lg flex items-center gap-3 justify-center"
      >
        Posts de Proyectos
      </h2>
    </div>
    <p
      class="text-xl text-gray-300 max-w-3xl text-center mb-10 leading-relaxed mx-auto"
    >
      Aquí publico novedades, avances y reflexiones sobre mis proyectos cloud,
      automatización y desarrollo web. Haz clic en cada proyecto para ver su
      evolución, cambios y detalles técnicos.
    </p>

    <div class="flex justify-center mb-12">
      <div class="bg-white/5 p-1 rounded-xl border border-white/10 flex gap-1">
        <button id="listViewBtn" class="view-toggle-btn active">
          <i class="fa-solid fa-list"></i>
          <span class="text-sm font-semibold">Lista</span>
        </button>
        <button id="gridViewBtn" class="view-toggle-btn">
          <i class="fa-solid fa-table-cells-large"></i>
          <span class="text-sm font-semibold">Matriz</span>
        </button>
      </div>
    </div>

    <div
      id="projectsList"
      class="w-full max-w-5xl mx-auto flex flex-col gap-10"
    >
      <!-- Tarjeta Proyecto 1 -->
      <div class="proyecto-card group border-fuchsia-400/30">
        <!-- Columna 1: Info -->
        <div
          class="flex-1 flex flex-col justify-center px-8 py-6 min-w-[220px]"
        >
          <h3 class="text-2xl font-bold text-fuchsia-300 mb-2">
            Integración de BBDD con Blockchain
          </h3>
          <p class="text-fuchsia-200 text-base mb-1">
            <span class="font-semibold">Estado:</span>
            <span class="text-emerald-300"> En producción</span>
          </p>
          <p class="text-fuchsia-100 text-sm mb-2">
            Desarrollé la integración de bases de datos relacionales
            tradicionales con tecnología blockchain, permitiendo registrar
            transacciones y auditorías de datos de forma inmutable y
            transparente.
          </p>
          <span class="text-xs text-fuchsia-200"
            ><i class="fa-solid fa-link mr-1"></i>#Blockchain & BBDD</span
          >
          <span class="text-xs text-pink-400 mt-2"
            ><i class="fa-solid fa-code-branch mr-1"></i>Última actualización:
            15/01/2025</span
          >
        </div>
        <!-- Columna 2: Terminal (bloque) -->
        <div
          class="flex-1 flex items-center justify-center transition-all duration-300"
        >
          <div class="terminal-block">
            <div
              class="terminal-header bg-gradient-to-r from-fuchsia-800/70 to-slate-800/70 border-b border-fuchsia-400/10"
            >
              <span class="h-3 w-3 rounded-full bg-red-500 mr-2"></span>
              <span class="h-3 w-3 rounded-full bg-yellow-400 mr-2"></span>
              <span class="h-3 w-3 rounded-full bg-green-500"></span>
              <span class="ml-4 text-fuchsia-300 font-mono text-sm">bash</span>
            </div>
            <div
              class="terminal-content text-fuchsia-100"
              style="background: linear-gradient(90deg, #3b0764 60%, #0f172a 100%); border-radius: 0 0 0.75rem 0.75rem;"
            >
              <p>
                <span class="text-fuchsia-400">nacho@proyectos</span>:<span
                  class="text-amber-300">~</span
                >$ <span class="text-white">cat blockchain_bd.txt</span>
              </p>
              <div class="h-3"></div>
              <p>
                <span class="text-fuchsia-300">Proyecto:</span> Integración de bases
                de datos relacionales con Blockchain <a
                  href="https://github.com/notpepejulian/MySQL-BigchainDB"
                  target="_blank"
                  class="hover:text-pink-300 inline-flex items-center gap-1 px-2 py-1 rounded-full bg-white/20 border border-gray-300/30 shadow-sm hover:bg-white/40 transition-colors duration-200 backdrop-blur-mdfont-semibold text-sm no-underline"
                  ><i class="fa-solid fa-circle-info"></i></a
                >
                <br />
              </p>
            </div>
          </div>
        </div>
        <!-- Columna 3: Saber Más -->
        <div
          class="flex flex-col items-center justify-center flex-1 min-w-[160px]transition-all duration-300"
        >
          <a
            href={`${import.meta.env.BASE_URL}proyectos/blockchain-integracion-bd/`}
            class="flex flex-col items-center justify-center h-full w-full py-8 group transition"
          >
            <span class="text-fuchsia-300 text-lg font-semibold mb-2"
              >Saber Más</span
            >
            <i
              class="fa-solid fa-arrow-right text-fuchsia-400 text-2xl transition-transform"
            ></i>
          </a>
        </div>
      </div>
      <!-- Tarjeta Proyecto 2 -->
      <div class="proyecto-card group border-emerald-400/30">
        <!-- Columna 1: Info -->
        <div
          class="flex-1 flex flex-col justify-center px-8 py-6 min-w-[220px]"
        >
          <h3 class="text-2xl font-bold text-emerald-300 mb-2">
            Pipeline DevOps CI/CD
          </h3>
          <p class="text-emerald-200 text-base mb-1">
            <span class="font-semibold">Estado:</span>
            <span class="text-emerald-300"> En producción</span>
          </p>
          <p class="text-emerald-100 text-sm mb-2">
            Implementación de pipelines CI/CD con Bitbucket Pipelines, Docker y
            despliegue automático en AWS.
          </p>
          <span class="text-xs text-emerald-200"
            ><i class="fa-solid fa-gears mr-1"></i>#DevOps</span
          >
          <span class="text-xs text-pink-400 mt-2"
            ><i class="fa-solid fa-code-branch mr-1"></i>Última actualización: <span
              id="fecha-actual"></span><script is:inline>
              (function () {
                function mostrarFechaActual() {
                  const fecha = new Date();
                  const dia = String(fecha.getDate()).padStart(2, "0");
                  const mes = String(fecha.getMonth() + 1).padStart(2, "0");
                  const año = fecha.getFullYear();
                  const fechaFormateada = `${dia}/${mes}/${año}`;
                  const elemento = document.getElementById("fecha-actual");
                  if (elemento) {
                    elemento.textContent = fechaFormateada;
                  }
                }
                if (document.readyState === "loading") {
                  document.addEventListener(
                    "DOMContentLoaded",
                    mostrarFechaActual,
                  );
                } else {
                  mostrarFechaActual();
                }
              })();
            </script></span
          >
        </div>
        <!-- Columna 2: Terminal (bloque) -->
        <div
          class="flex-1 flex items-center justify-center transition-all duration-300"
        >
          <div class="terminal-block">
            <div
              class="terminal-header bg-gradient-to-r from-emerald-800/70 to-slate-800/70 border-b border-emerald-400/10"
            >
              <span class="h-3 w-3 rounded-full bg-red-500 mr-2"></span>
              <span class="h-3 w-3 rounded-full bg-yellow-400 mr-2"></span>
              <span class="h-3 w-3 rounded-full bg-green-500"></span>
              <span class="ml-4 text-emerald-300 font-mono text-sm">bash</span>
            </div>
            <div
              class="terminal-content text-emeral-100"
              style="background: linear-gradient(135deg, #1c4a38 0%, #0f172a 100%); border-radius: 0 0 0.75rem 0.75rem;"
            >
              <p>
                <span class="text-emerald-400">nacho@proyectos</span>:<span
                  class="text-amber-300">~</span
                >$ <span class="text-white">cat devops_pipeline.txt</span>
              </p>
              <div class="h-3"></div>
              <p>
                <span class="text-emerald-300">Proyecto:</span> Pipeline DevOps CI/CD
                <br />
              </p>
            </div>
          </div>
        </div>
        <!-- Columna 3: Saber Más -->
        <div
          class="flex flex-col items-center justify-center flex-1 min-w-[160px]transition-all duration-300"
        >
          <a
            href={`${import.meta.env.BASE_URL}proyectos/devops-pipeline/`}
            class="flex flex-col items-center justify-center h-full w-full py-8 group transition"
          >
            <span class="text-emerald-300 text-lg font-semibold mb-2"
              >Saber Más</span
            >
            <i
              class="fa-solid fa-arrow-right text-emerald-400 text-2xl transition-transform"
            ></i>
          </a>
        </div>
      </div>
      <!-- Tarjeta Proyecto 3 -->
      <div class="proyecto-card group border-blue-400\/30">
        <!-- Columna 1: Info -->
        <div
          class="flex-1 flex flex-col justify-center px-8 py-6 min-w-[220px]"
        >
          <h3 class="text-2xl font-bold text-blue-300 mb-2">
            Web De Mensajeria Anónima
          </h3>
          <p class="text-blue-200 text-base mb-1">
            <span class="font-semibold">Estado:</span>
            <span class="text-yellow-300"> En desarrollo</span>
          </p>
          <p class="text-blue-100 text-sm mb-2">
            Una página web que permite enviar mensajes anónimos entre usuarios.
          </p>
          <span class="text-xs text-blue-200"
            ><i class="fa-brands fa-linux mr-1"></i>#Web & Security</span
          >
          <span class="text-xs text-pink-400 mt-2"
            ><i class="fa-solid fa-code-branch mr-1"></i>Última actualización:
            24/01/2026</span
          >
        </div>
        <!-- Columna 2: Terminal (bloque) -->
        <div
          class="flex-1 flex items-center justify-center transition-all duration-300"
        >
          <div class="terminal-block">
            <div
              class="terminal-header bg-gradient-to-r from-blue-700/70 to-slate-800/70 border-b border-blue-400/10"
            >
              <span class="h-3 w-3 rounded-full bg-red-500 mr-2"></span>
              <span class="h-3 w-3 rounded-full bg-orange-400 mr-2"></span>
              <span class="h-3 w-3 rounded-full bg-green-500"></span>
              <span class="ml-4 text-blue-300 font-mono text-sm">bash</span>
            </div>
            <div
              class="terminal-content text-blue-100"
              style="background: linear-gradient(135deg, #15213d 0%, #0f172a 100%); border-radius: 0 0 0.75rem 0.75rem;"
            >
              <p>
                <span class="text-blue-400">nacho@proyectos</span>:<span
                  class="text-amber-300">~</span
                >$ <span class="text-white">cat ChatSender.txt</span>
              </p>
              <div class="h-3"></div>
              <p>
                <span class="text-blue-300">Proyecto:</span> Web De Mensajeria Anónima
                <br />
              </p>
            </div>
          </div>
        </div>
        <!-- Columna 3: Saber Más -->
        <div
          class="flex flex-col items-center justify-center flex-1 min-w-[160px]transition-all duration-300"
        >
          <a
            href={`${import.meta.env.BASE_URL}proyectos/ChatSender/`}
            class="flex flex-col items-center justify-center h-full w-full py-8 group transition"
          >
            <span class="text-blue-300 text-lg font-semibold mb-2"
              >Saber Más</span
            >
            <i
              class="fa-solid fa-arrow-right text-blue-400 text-2xl transition-transform"
            ></i>
          </a>
        </div>
      </div>
      <!-- Tarjeta Proyecto 4 -->
      <div class="proyecto-card group border-red-400/30">
        <!-- Columna 1: Info -->
        <div
          class="flex-1 flex flex-col justify-center px-8 py-6 min-w-[220px]"
        >
          <h3 class="text-2xl font-bold text-red-500 mb-2">
            Pagina Educativa Tests de Autoescuela
          </h3>
          <p class="text-red-400 text-base mb-1">
            <span class="font-semibold">Estado:</span>
            <span class="text-amber-300"> En desarrollo</span>
          </p>
          <p class="text-red-100 text-sm mb-2">
            Implementación de pipelines CI/CD con Bitbucket Pipelines, Docker y
            despliegue automático en AWS.
          </p>
          <span class="text-xs text-red-200"
            ><i class="fa-solid fa-code mr-1"></i>#Desarrollo Web</span
          >
          <span class="text-xs text-pink-400 mt-2"
            ><i class="fa-solid fa-code-branch mr-1"></i>Última actualización:
            15/11/2025</span
          >
        </div>
        <!-- Columna 2: Terminal (bloque) -->
        <div
          class="flex-1 flex items-center justify-center transition-all duration-300"
        >
          <div class="terminal-block">
            <div
              class="terminal-header bg-gradient-to-r from-red-800/70 to-slate-800/70 border-b border-red-400/10"
            >
              <span class="h-3 w-3 rounded-full bg-red-500 mr-2"></span>
              <span class="h-3 w-3 rounded-full bg-yellow-400 mr-2"></span>
              <span class="h-3 w-3 rounded-full bg-green-500"></span>
              <span class="ml-4 text-red-300 font-mono text-sm">bash</span>
            </div>
            <div
              class="terminal-content text-emeral-100"
              style="background: linear-gradient(135deg, #4a1c1c 0%, #0f172a 100%); border-radius: 0 0 0.75rem 0.75rem;"
            >
              <p>
                <span class="text-red-500">nacho@proyectos</span>:<span
                  class="text-amber-300">~</span
                >$ <span class="text-white">cat AutoTest.txt</span>
              </p>
              <div class="h-3"></div>
              <p>
                <span class="text-red-500">Proyecto: </span><a
                  href="https://github.com/notpepejulian/AutoTest"
                  target="_blank"
                  class="hover:text-pink-300 inline-flex items-center gap-1 px-2 py-1 rounded-full bg-white/20 border border-gray-300/30 shadow-sm hover:bg-white/40 transition-colors duration-200 backdrop-blur-mdfont-semibold text-sm no-underline"
                  ><i class="fa-solid fa-circle-info mr-1"></i>AutoTest.es</a
                >
                <br />
              </p>
            </div>
          </div>
        </div>
        <!-- Columna 3: Saber Más -->
        <div
          class="flex flex-col items-center justify-center flex-1 min-w-[160px]transition-all duration-300"
        >
          <a
            href={`${import.meta.env.BASE_URL}proyectos/AutoTest/`}
            class="flex flex-col items-center justify-center h-full w-full py-8 group transition"
          >
            <span class="text-red-500 text-lg font-semibold mb-2"
              >Saber Más</span
            >
            <i
              class="fa-solid fa-arrow-right text-red-500 text-2xl transition-transform"
            ></i>
          </a>
        </div>
      </div>
      <!-- Tarjeta Proyecto 5 -->
      <div class="proyecto-card group border-cyan-400/30">
        <!-- Columna 1: Info -->
        <div
          class="flex-1 flex flex-col justify-center px-8 py-6 min-w-[220px]"
        >
          <h3 class="text-2xl font-bold text-cyan-300 mb-2">
            WebApp de Monitorización Cloud
          </h3>
          <p class="text-cyan-200 text-base mb-1">
            <span class="font-semibold">Estado:</span>
