---
import { useTranslations, defaultLang } from "../../utils/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
const lang = Astro.currentLocale || defaultLang;
const t = useTranslations(lang);
import Layout from "../../layouts/Layout.astro";
---

<style>
	html {
		scroll-behavior: smooth;
	}

	/* Animación de tecnologías desplazándose */
	@keyframes scroll {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	.tech-scroll {
		animation: scroll 30s linear infinite;
	}

	.tech-scroll:hover {
		animation-play-state: paused;
	}

	.tech-container {
		overflow: hidden;
		mask-image: linear-gradient(
			to right,
			transparent,
			black 10%,
			black 90%,
			transparent
		);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent,
			black 10%,
			black 90%,
			transparent
		);
	}
</style>

<Layout>
	<main
		class="flex flex-col min-h-screen items-center justify-center px-6 py-20 bg-transparent relative"
	>
		<div class="max-w-4xl w-full text-center z-10">
            <div
                class="inline-flex items-center gap-4 px-4 py-1.5 border border-emerald-400/20 rounded bg-emerald-500/10 mb-6"
            >
                <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"
                ></span>
                <span class="text-emerald-300 font-mono text-[10px] tracking-widest uppercase font-bold"
                    >En Producción</span
                >
            </div>
            <h1
                class="font-headline text-5xl md:text-7xl font-bold tracking-tighter bg-gradient-to-r from-emerald-400 via-green-400 to-teal-400 bg-clip-text text-transparent mb-6"
            >
                Pipeline DevOps CI/CD
            </h1>
            <p class="text-xl sm:text-2xl font-light text-on-surface-variant mb-6">
                Automatización de Despliegues y Builds en AWS
            </p>
            <p
                class="text-lg text-on-surface-variant font-light mb-10 max-w-2xl mx-auto leading-relaxed"
            >
                Implementación de pipelines CI/CD para automatizar builds de
                Docker, despliegues en AWS, gestión de entornos de prueba y
                CodeDeploys automáticos.
            </p>
            <a
                href={getRelativeLocaleUrl(lang, 'proyectos/')}
                class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-emerald-300 font-headline tracking-wider uppercase text-xs shadow-lg transition-all duration-200 border border-emerald-400/30"
            >
                {t('projects.back')}
            </a>
		</div>
	</main>

	<section class="mt-10 mb-40 w-full flex flex-col items-center px-6">
		<div class="w-full max-w-6xl mx-auto space-y-24">
			<!-- Casos de Uso -->
			<div>
				<h2
					class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-green-400 to-teal-400 mb-8 text-center"
				>
					Casos de Uso
				</h2>
				<div class="max-w-4xl mx-auto">
					<p
						class="text-lg text-gray-300 leading-relaxed mb-6 text-center"
					>
						Estos pipelines están diseñados para <strong
							class="text-emerald-300"
							>automatizar completamente el ciclo de vida</strong
						> del desarrollo y despliegue de aplicaciones. Algunos casos
						de uso incluyen:
					</p>
					<div class="grid md:grid-cols-3 gap-6 mt-8">
						<div
							class="group bg-surface-container-low/40 hover:bg-surface-container/80 transition-all duration-300 border border-emerald-400/20 rounded-[2rem] p-6 hover-glow-emerald backdrop-blur-md relative overflow-hidden"
						>
                            <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center mb-4">
                                <span class="material-symbols-outlined text-emerald-400">deployed_code</span>
                            </div>
							<h3
								class="text-emerald-300 font-semibold text-lg mb-2"
							>
								Builds Automáticos
							</h3>
							<p class="text-gray-300 text-sm leading-relaxed">
								Construcción automática de imágenes Docker desde
								Dockerfiles al hacer commits, optimizando el
								proceso de build y testing.
							</p>
						</div>
						<div
							class="group bg-surface-container-low/40 hover:bg-surface-container/80 transition-all duration-300 border border-emerald-400/20 rounded-[2rem] p-6 hover-glow-emerald backdrop-blur-md relative overflow-hidden"
						>
                            <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center mb-4">
                                <span class="material-symbols-outlined text-emerald-400">cloud</span>
                            </div>
							<h3
								class="text-emerald-300 font-semibold text-lg mb-2"
							>
								Despliegues en AWS
							</h3>
							<p class="text-gray-300 text-sm leading-relaxed">
								Despliegue automático de contenedores Docker en
								AWS tras builds exitosos, con actualización de
								servicios y tareas.
							</p>
						</div>
						<div
							class="group bg-surface-container-low/40 hover:bg-surface-container/80 transition-all duration-300 border border-emerald-400/20 rounded-[2rem] p-6 hover-glow-emerald backdrop-blur-md relative overflow-hidden"
						>
                            <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center mb-4">
                                <span class="material-symbols-outlined text-emerald-400">power_settings_new</span>
                            </div>
							<h3
								class="text-emerald-300 font-semibold text-lg mb-2"
							>
								Gestión de Entornos
							</h3>
							<p class="text-gray-300 text-sm leading-relaxed">
								Automatización del apagado y encendido de
								entornos de prueba según horarios o eventos,
								optimizando costos.
							</p>
						</div>
						<div
							class="group bg-surface-container-low/40 hover:bg-surface-container/80 transition-all duration-300 border border-emerald-400/20 rounded-[2rem] p-6 hover-glow-emerald backdrop-blur-md relative overflow-hidden"
						>
                            <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center mb-4">
                                <span class="material-symbols-outlined text-emerald-400">route</span>
                            </div>
							<h3
								class="text-emerald-300 font-semibold text-lg mb-2"
							>
								CodeDeploy Automático
							</h3>
							<p class="text-gray-300 text-sm leading-relaxed">
								Despliegues automáticos mediante AWS CodeDeploy
								al detectar commits en repositorios, sin
								intervención manual.
							</p>
						</div>
						<div
							class="group bg-surface-container-low/40 hover:bg-surface-container/80 transition-all duration-300 border border-emerald-400/20 rounded-[2rem] p-6 hover-glow-emerald backdrop-blur-md relative overflow-hidden"
						>
                            <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center mb-4">
                                <span class="material-symbols-outlined text-emerald-400">science</span>
                            </div>
							<h3
								class="text-emerald-300 font-semibold text-lg mb-2"
							>
								Testing Continuo
							</h3>
							<p class="text-gray-300 text-sm leading-relaxed">
								Ejecución automática de tests en cada build,
								garantizando calidad antes del despliegue a
								producción.
							</p>
						</div>
						<div
							class="group bg-surface-container-low/40 hover:bg-surface-container/80 transition-all duration-300 border border-emerald-400/20 rounded-[2rem] p-6 hover-glow-emerald backdrop-blur-md relative overflow-hidden"
						>
                            <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center mb-4">
                                <span class="material-symbols-outlined text-emerald-400">sync</span>
                            </div>
							<h3
								class="text-emerald-300 font-semibold text-lg mb-2"
							>
								CI/CD Completo
							</h3>
							<p class="text-gray-300 text-sm leading-relaxed">
								Integración y despliegue continuo con Bitbucket
								Pipelines, automatizando todo el flujo desde
								código hasta producción.
							</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Arquitectura -->
			<div>
				<h2
					class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-green-400 to-teal-400 mb-8 text-center"
				>
					Arquitectura del Pipeline
				</h2>
				<div class="max-w-5xl mx-auto">
					<div class="grid md:grid-cols-2 gap-6">
						<div
							class="group bg-surface-container-low/40 hover:bg-surface-container/80 transition-all duration-300 border border-emerald-400/20 rounded-[2rem] p-6 hover-glow-emerald backdrop-blur-md relative overflow-hidden"
						>
							<div class="flex items-center gap-3 mb-4">
                                <div
                                    class="w-12 h-12 rounded-full bg-emerald-500/20 flex items-center justify-center"
                                >
                                    <span class="material-symbols-outlined text-emerald-400">commit</span>
                                </div>
								<h3 class="text-xl font-bold text-emerald-300">
									Bitbucket Pipelines
								</h3>
							</div>
							<p class="text-gray-300 text-sm mb-3">
								<strong class="text-emerald-300"
									>CI/CD Platform</strong
								>
							</p>
							<ul class="text-gray-300 text-sm space-y-1.5">
								<li class="flex items-start gap-2">
									<span class="text-emerald-400 mt-1">•</span>
									<span
										>Ejecución de pipelines en cada commit</span
									>
								</li>
								<li class="flex items-start gap-2">
									<span class="text-emerald-400 mt-1">•</span>
									<span
										>Configuración mediante
										bitbucket-pipelines.yml</span
									>
								</li>
								<li class="flex items-start gap-2">
									<span class="text-emerald-400 mt-1">•</span>
									<span>Integración con repositorios Git</span
									>
								</li>
							</ul>
						</div>

						<div
							class="group bg-surface-container-low/40 hover:bg-surface-container/80 transition-all duration-300 border border-blue-400/20 rounded-[2rem] p-6 hover-glow-blue backdrop-blur-md relative overflow-hidden"
						>
							<div class="flex items-center gap-3 mb-4">
                                <div
                                    class="w-12 h-12 rounded-full bg-blue-500/20 flex items-center justify-center"
                                >
                                    <span class="material-symbols-outlined text-blue-400">deployed_code</span>
                                </div>
								<h3 class="text-xl font-bold text-blue-300">
									Docker
								</h3>
							</div>
							<p class="text-gray-300 text-sm mb-3">
								<strong class="text-blue-300"
									>Containerización</strong
								>
							</p>
							<ul class="text-gray-300 text-sm space-y-1.5">
								<li class="flex items-start gap-2">
									<span class="text-blue-400 mt-1">•</span>
									<span
										>Build automático de imágenes desde
										Dockerfile</span
									>
								</li>
								<li class="flex items-start gap-2">
									<span class="text-blue-400 mt-1">•</span>
									<span
										>Push a registros de contenedores (ECR)</span
									>
								</li>
								<li class="flex items-start gap-2">
									<span class="text-blue-400 mt-1">•</span>
									<span>Optimización de capas y cache</span>
								</li>
							</ul>
						</div>

						<div
							class="group bg-surface-container-low/40 hover:bg-surface-container/80 transition-all duration-300 border border-orange-400/20 rounded-[2rem] p-6 hover-glow-orange backdrop-blur-md relative overflow-hidden"
						>
							<div class="flex items-center gap-3 mb-4">
                                <div
                                    class="w-12 h-12 rounded-full bg-orange-500/20 flex items-center justify-center"
                                >
                                    <span class="material-symbols-outlined text-orange-400">cloud</span>
                                </div>
								<h3 class="text-xl font-bold text-orange-300">
									AWS
								</h3>
							</div>
							<p class="text-gray-300 text-sm mb-3">
								<strong class="text-orange-300"
									>Container Service</strong
								>
							</p>
							<ul class="text-gray-300 text-sm space-y-1.5">
								<li class="flex items-start gap-2">
									<span class="text-orange-400 mt-1">•</span>
									<span
										>Despliegue automático de contenedores</span
									>
								</li>
								<li class="flex items-start gap-2">
									<span class="text-orange-400 mt-1">•</span>
									<span
										>Actualización de servicios y tareas</span
									>
								</li>
								<li class="flex items-start gap-2">
									<span class="text-orange-400 mt-1">•</span>
									<span
										>Escalado automático y alta
										disponibilidad</span
									>
								</li>
							</ul>
						</div>

						<div
							class="group bg-surface-container-low/40 hover:bg-surface-container/80 transition-all duration-300 border border-purple-400/20 rounded-[2rem] p-6 hover-glow-purple backdrop-blur-md relative overflow-hidden"
						>
							<div class="flex items-center gap-3 mb-4">
                                <div
                                    class="w-12 h-12 rounded-full bg-purple-500/20 flex items-center justify-center"
                                >
                                    <span class="material-symbols-outlined text-purple-400">code</span>
                                </div>
								<h3 class="text-xl font-bold text-purple-300">
									AWS CodeDeploy
								</h3>
							</div>
							<p class="text-gray-300 text-sm mb-3">
								<strong class="text-purple-300"
									>Despliegue Automático</strong
								>
							</p>
							<ul class="text-gray-300 text-sm space-y-1.5">
								<li class="flex items-start gap-2">
									<span class="text-purple-400 mt-1">•</span>
									<span
										>Despliegues automáticos desde
										repositorios</span
									>
								</li>
								<li class="flex items-start gap-2">
									<span class="text-purple-400 mt-1">•</span>
									<span
										>Estrategias de despliegue configurables</span
									>
								</li>
								<li class="flex items-start gap-2">
									<span class="text-purple-400 mt-1">•</span>
									<span
										>Rollback automático en caso de fallos</span
									>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>

			<!-- Flujo de Automatización -->
			<div>
				<h2
					class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-green-400 to-teal-400 mb-8 text-center"
				>
					Flujo de Automatización
				</h2>
				<div class="max-w-4xl mx-auto">
					<div
						class="bg-surface-container/40 border border-emerald-400/20 rounded-[2.5rem] p-8 md:p-12 backdrop-blur-md"
					>
						<div class="space-y-8">
							<div>
								<div class="flex items-center gap-3 mb-4">
									<div
										class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center"
									>
										<span class="text-emerald-400 font-bold"
											>1</span
										>
									</div>
									<h3
										class="text-xl font-bold text-emerald-300"
									>
										Commit y Trigger
									</h3>
								</div>
								<div class="ml-14 space-y-2 text-on-surface-variant font-light">
									<p class="flex items-start gap-2">
										<span class="text-emerald-400 mt-1"
											>·</span
										>
										<span
											>Desarrollador hace commit y push al
											repositorio</span
										>
									</p>
									<p class="flex items-start gap-2">
										<span class="text-emerald-400 mt-1"
											>·</span
										>
										<span
											>Bitbucket Pipelines detecta el
											cambio automáticamente</span
										>
									</p>
									<p class="flex items-start gap-2">
										<span class="text-emerald-400 mt-1"
											>·</span
										>
										<span
											>Se inicia el pipeline configurado
											según la rama</span
										>
									</p>
								</div>
							</div>

							<div class="border-t border-emerald-400/20 pt-8">
								<div class="flex items-center gap-3 mb-4">
									<div
										class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center"
									>
										<span class="text-emerald-400 font-bold"
											>2</span
										>
									</div>
									<h3
										class="text-xl font-bold text-emerald-300"
									>
										Build de Docker
									</h3>
								</div>
								<div class="ml-14 space-y-2 text-on-surface-variant font-light">
									<p class="flex items-start gap-2">
										<span class="text-emerald-400 mt-1"
											>·</span
										>
										<span
											>Construcción automática de imagen
											Docker desde Dockerfile</span
										>
									</p>
									<p class="flex items-start gap-2">
										<span class="text-emerald-400 mt-1"
											>·</span
										>
										<span
											>Ejecución de tests y validaciones
											durante el build</span
										>
									</p>
									<p class="flex items-start gap-2">
										<span class="text-emerald-400 mt-1"
											>·</span
										>
										<span
											>Push de la imagen a AWS ECR
											(Elastic Container Registry)</span
										>
									</p>
								</div>
							</div>

							<div class="border-t border-emerald-400/20 pt-8">
								<div class="flex items-center gap-3 mb-4">
									<div
										class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center"
									>
										<span class="text-emerald-400 font-bold"
											>3</span
										>
									</div>
									<h3
										class="text-xl font-bold text-emerald-300"
									>
										Despliegue en AWS
									</h3>
								</div>
								<div class="ml-14 space-y-2 text-on-surface-variant font-light">
									<p class="flex items-start gap-2">
										<span class="text-emerald-400 mt-1"
											>·</span
										>
										<span
											>Actualización automática del
											servicio ECS con la nueva imagen</span
										>
									</p>
									<p class="flex items-start gap-2">
										<span class="text-emerald-400 mt-1"
											>·</span
										>
										<span
											>Despliegue gradual con health
											checks</span
										>
									</p>
									<p class="flex items-start gap-2">
										<span class="text-emerald-400 mt-1"
											>·</span
										>
										<span
											>Notificaciones de estado del
											despliegue</span
										>
									</p>
								</div>
							</div>

							<div class="border-t border-emerald-400/20 pt-8">
								<div class="flex items-center gap-3 mb-4">
									<div
										class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center"
									>
										<span class="text-emerald-400 font-bold"
											>4</span
										>
									</div>
									<h3
										class="text-xl font-bold text-emerald-300"
									>
										Gestión de Entornos
									</h3>
								</div>
								<div class="ml-14 space-y-2 text-on-surface-variant font-light">
									<p class="flex items-start gap-2">
										<span class="text-emerald-400 mt-1"
											>·</span
										>
										<span
											>Apagado automático de entornos de
											prueba en horarios no laborables</span
										>
									</p>
									<p class="flex items-start gap-2">
										<span class="text-emerald-400 mt-1"
											>·</span
										>
										<span
											>Encendido automático al detectar
											actividad o commits</span
										>
									</p>
									<p class="flex items-start gap-2">
										<span class="text-emerald-400 mt-1"
											>·</span
										>
										<span
											>Optimización de costos mediante
											gestión inteligente de recursos</span
										>
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Tecnologías Empleadas -->
			<div>
				<h2
					class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-green-400 to-teal-400 mb-8 text-center"
				>
					Tecnologías Empleadas
				</h2>
				<div class="tech-container">
					<div class="flex tech-scroll gap-8">
						<!-- Primera copia -->
						<div class="flex gap-8 flex-shrink-0">
							<div
								class="flex flex-col items-center justify-center w-32 group bg-surface-container-low/40 hover:bg-surface-container/80 transition-all duration-300 border border-emerald-400/20 rounded-[2rem] backdrop-blur-sm p-6 hover-glow-emerald"
							>
                                <span class="material-symbols-outlined text-[3rem] text-emerald-400 mb-2">commit</span>
								<span
									class="text-[13px] text-emerald-300 font-medium text-center"
									>Bitbucket</span
								>
							</div>
							<div
								class="flex flex-col items-center justify-center w-32 group bg-surface-container-low/40 hover:bg-surface-container/80 transition-all duration-300 border border-blue-400/20 rounded-[2rem] backdrop-blur-sm p-6 hover-glow-blue"
							>
                                <span class="material-symbols-outlined text-[3rem] text-blue-400 mb-2">deployed_code</span>
								<span
									class="text-[13px] text-blue-300 font-medium text-center"
									>Docker</span
								>
							</div>
							<div
